<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/terms_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadeScrollbars="false"
    android:scrollbarStyle="outsideInset"
    android:paddingHorizontal="24dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_section_toolbar"
            android:padding="12dp"
            android:text="@string/registration_terms_scroll_hint"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/news_control_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="@string/registration_terms_body"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/news_control_text" />
    </LinearLayout>
</ScrollView>
