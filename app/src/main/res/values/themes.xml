<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NewsApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.NewsApp" parent="Base.Theme.NewsApp">
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.NewsApp.Dialog</item>
        <item name="snackbarStyle">@style/Widget.NewsApp.Snackbar</item>
    </style>

    <style name="ThemeOverlay.NewsApp.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.NewsApp</item>
    </style>

    <style name="MaterialAlertDialog.NewsApp" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="shapeAppearance">@style/ShapeAppearance.NewsApp.Dialog</item>
    </style>

    <style name="ShapeAppearance.NewsApp.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Widget.NewsApp.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="shapeAppearance">@style/ShapeAppearance.NewsApp.Snackbar</item>
        <item name="android:layout_margin">16dp</item>
    </style>

    <style name="ShapeAppearance.NewsApp.Snackbar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
